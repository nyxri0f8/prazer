# Supabase Configuration (Connected to live project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PQAI Configuration (Cloud Hosted or Local Self-Hosted from pqai-master/)
# For Cloud: https://api.projectpq.ai/search/102/ (requires key)
# For Local: http://localhost:5000/search/102/ (no cloud key required)
PQAI_API_URL=https://nyxvarun-prazer-pqai.hf.space/
PQAI_API_KEY=

# Groq Hosted API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Local Fallback Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Backend Configuration
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=*
